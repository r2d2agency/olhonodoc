generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductFeatured {
  NONE
  FEATURED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponTargetType {
  EMAIL
  CPF
  CUSTOMER
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  COMPLETED
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String?
  username     String?  @unique
  email        String?  @unique
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  authCodes    AuthCode[]
  sessions     Session[]
}

model AuthCode {
  id         String   @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  shortName   String
  description String
  priceCents  Int
  accent      String?
  features    Json
  useCase     String
  promotionalPriceCents Int?
  promotionStart DateTime?
  promotionEnd DateTime?
  featured    ProductFeatured @default(NONE)
  sortOrder   Int @default(0)
  image       String?
  ctaText     String?
  seoTitle    String?
  seoDescription String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orders      Order[]
  coupons     Coupon[]
}

model Customer {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  phone        String?
  cpf          String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
  assignments  CouponAssignment[]
  redemptions  CouponRedemption[]
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  description       String?
  discountType      CouponDiscountType
  value             Int
  status            CouponStatus        @default(ACTIVE)
  startsAt          DateTime?
  endsAt            DateTime?
  maxRedemptions    Int?
  redemptionCount   Int                @default(0)
  perCustomerLimit  Int?
  minOrderCents     Int?
  maxDiscountCents  Int?
  productId         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  product           Product?           @relation(fields: [productId], references: [id])
  assignments       CouponAssignment[]
  redemptions       CouponRedemption[]
  orders            Order[]

  @@index([status, startsAt, endsAt])
}

model CouponAssignment {
  id           String          @id @default(cuid())
  couponId     String
  targetType   CouponTargetType
  targetValue  String
  customerId   String?
  coupon       Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@unique([couponId, targetType, targetValue])
  @@index([targetType, targetValue])
}

model CouponRedemption {
  id          String    @id @default(cuid())
  couponId    String
  orderId     String    @unique
  customerId  String?
  code        String
  discountCents Int
  createdAt   DateTime  @default(now())
  reversedAt  DateTime?
  coupon      Coupon    @relation(fields: [couponId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([couponId, createdAt])
  @@index([customerId, couponId])
}

model Order {
  id             String             @id @default(cuid())
  plate          String
  productId      String
  customerId     String?
  couponId       String?
  status         OrderStatus        @default(PENDING)
  amountCents    Int
  subtotalCents  Int?
  discountCents  Int                @default(0)
  totalCents     Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  product        Product            @relation(fields: [productId], references: [id])
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon         Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemption     CouponRedemption?
  query          VehicleQuery?

  @@index([plate])
  @@index([status])
}

model VehicleQuery {
  id              String   @id @default(cuid())
  orderId         String   @unique
  normalizedPlate String
  report          Json?
  queriedAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([normalizedPlate])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  content        String
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model FaqEntry {
  id        String        @id @default(cuid())
  question  String
  answer    String
  status    ContentStatus @default(PUBLISHED)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

model MarketingCampaign {
  id         String        @id @default(cuid())
  name       String
  source     String
  medium     String
  campaign   String
  content    String?
  targetUrl  String
  status     ContentStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model HomeSection {
  id        String   @id @default(cuid())
  type      String
  name      String
  status    ProductStatus @default(ACTIVE)
  sortOrder Int      @default(0)
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}